# Token da API IronPay (painel > configurações de API)
IRONPAY_API_TOKEN=seu_token_aqui

# ── Dois tickets (duas ofertas na IronPay) ──────────────────────────
# Ticket 1 — só espelho (R$ 57,50)
IRONPAY_OFFER_HASH=hash_oferta_5750

# Ticket 2 — espelho + order bump maleta (R$ 77,40)
IRONPAY_BUMP_OFFER_HASH=hash_oferta_7740

# Produto espelho (item principal no carrinho)
IRONPAY_PRODUCT_HASH=hash_produto_espelho

# Produto maleta/bump (opcional — se vazio, usa IRONPAY_PRODUCT_HASH)
IRONPAY_BUMP_PRODUCT_HASH=

# Opcional: oferta do upsell pós-compra (frete do prêmio)
# IRONPAY_UPSELL_OFFER_HASH=

# URL pública do webhook (postback)
IRONPAY_POSTBACK_URL=

# URL base da API local (webhook em dev)
PUBLIC_BASE_URL=http://localhost:3001
